{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": ["NODE_ENV", "E2E_BACKEND_URL", "E2E_INTERVIEW_ID"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "agent:start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "env": [
        "LIVEKIT_URL",
        "LIVEKIT_API_KEY",
        "LIVEKIT_API_SECRET",
        "LIVEKIT_AGENT_NAME",
        "ROOM_NAME",
        "DEEPGRAM_API_KEY",
        "DEEPGRAM_MODEL",
        "DEEPGRAM_UTTERANCE_END_MS",
        "AI_ROUTER_BASE_URL",
        "AI_ROUTER_API_KEY",
        "AI_ROUTER_MODEL",
        "LLM_TEMPERATURE",
        "SARVAM_API_KEY",
        "SARVAM_MODEL",
        "SARVAM_SPEAKER",
        "SARVAM_TARGET_LANGUAGE",
        "AGENT_LANGUAGE",
        "BACKEND_BASE_URL",
        "INTERNAL_API_TOKEN"
      ]
    },
    "backend:start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build"],
      "env": [
        "NODE_ENV",
        "PORT",
        "DATABASE_URL",
        "AI_ROUTER_BASE_URL",
        "AI_ROUTER_API_KEY",
        "AI_ROUTER_MODEL",
        "LLM_TEMPERATURE",
        "LIVEKIT_URL",
        "LIVEKIT_API_KEY",
        "LIVEKIT_API_SECRET",
        "INTERNAL_API_TOKEN"
      ],
      "envMode": "loose"
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
