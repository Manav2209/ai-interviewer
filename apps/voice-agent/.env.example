# LiveKit (Cloud or self-hosted)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram streaming STT
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# STT endpointing completes candidate turns; Silero VAD detects interruptions.
DEEPGRAM_UTTERANCE_END_MS=800
DEEPGRAM_TTS_MODEL=aura-2-andromeda-en

# GPT-OSS through AI Router (OpenAI-compatible endpoint)
AI_ROUTER_BASE_URL=
AI_ROUTER_API_KEY=
AI_ROUTER_MODEL=
LLM_TEMPERATURE=

# Agent
AGENT_LANGUAGE=en
ROOM_NAME=realtime-test-001

# Backend control path (agent -> backend events + context fetch)
BACKEND_BASE_URL=http://localhost:8080
INTERNAL_API_TOKEN=

# Optional persistent volume for unacknowledged voice events. Defaults to OS temp.
# VOICE_OUTBOX_DIR=
