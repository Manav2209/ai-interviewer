# LiveKit (Cloud or self-hosted)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Deepgram streaming STT
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Deepgram silence-based endpointing (utterance_end_ms). This is the source of
# truth for "candidate has finished speaking" (spec §5). Set e.g. 800.
DEEPGRAM_UTTERANCE_END_MS=

# GPT-OSS through AI Router (OpenAI-compatible endpoint)
AI_ROUTER_BASE_URL=
AI_ROUTER_API_KEY=
AI_ROUTER_MODEL=
LLM_TEMPERATURE=

# Sarvam TTS
SARVAM_API_KEY=
SARVAM_MODEL=bulbul:v3
SARVAM_SPEAKER=shubh
SARVAM_TARGET_LANGUAGE=en-IN

# Agent
AGENT_LANGUAGE=en
ROOM_NAME=realtime-test-001